# ---- Threat intelligence (backend-only; never exposed to the browser) ----
# VirusTotal API v3 key: https://www.virustotal.com/gui/my-apikey  (free tier: 4 requests/min, 500/day)
VT_API_KEY=your_virustotal_api_key
# URLhaus / abuse.ch Auth-Key: sign in at https://auth.abuse.ch/ and create an Auth-Key (free)
URLHAUS_AUTH_KEY=your_urlhaus_auth_key
# Optional: let VirusTotal analyse URLs it has never seen (VirusTotal fetches the URL, not this server; URL becomes visible to VT). Default off.
# VT_SUBMIT_UNKNOWN=false

# ---- Application ----
# SQLite is used when empty. Postgres example: postgresql://pg:pg@localhost/phishguard
DATABASE_URL=
# Folder containing random_forest.joblib + metrics.json (default: ../ml_models)
MODEL_DIR=../ml_models
MAX_APK_MB=100
CORS_ORIGINS=http://localhost:5173